# Site block for /etc/caddy/Caddyfile.
# The admin credentials live in a separate file, /etc/caddy/imbulforever-admin.caddy,
# written by deploy/set-admin-password.sh, so this block never contains a password hash.

imbulforever.yagi.hu {
	encode gzip

	# Admin page and write API: basic auth, credentials in imbulforever-admin.caddy
	import /etc/caddy/imbulforever-admin.caddy

	handle /api/* {
		reverse_proxy 127.0.0.1:8001
	}
	handle /admin/api/* {
		reverse_proxy 127.0.0.1:8001
	}
	handle {
		# Browsers may cache the files but must check for a newer version every time (a cheap 304 if unchanged),
		# so after a deploy nobody gets an old script with a new page.
		header Cache-Control "no-cache"
		root * /var/www/imbulforever.yagi.hu
		file_server
	}
}
